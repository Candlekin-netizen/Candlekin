{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/page-public-guard"
    },
    {
      "src": "^/admin/preview/?$",
      "dest": "/api/admin-preview-page"
    },
    {
      "src": "^/admin/?$",
      "dest": "/api/admin-page"
    },
    {
      "handle": "filesystem"
    }
  ]
}
